# Sao chép file này thành ".env" (cùng thư mục) rồi chỉnh nếu cần.
# Mặc định đã khớp với XAMPP mới cài: user root, KHÔNG có mật khẩu.

PORT=5000

# --- MySQL / MariaDB trong XAMPP ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=techstore_db

# --- Bảo mật ---
# Đổi thành chuỗi ngẫu nhiên dài (>= 32 ký tự) trước khi đưa lên môi trường thật.
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-tren-32-ky-tu
JWT_EXPIRES_IN=7d

# Các địa chỉ frontend được phép gọi API (cách nhau bằng dấu phẩy)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
