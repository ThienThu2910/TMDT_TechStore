FROM node:22-bookworm-slim
WORKDIR /app
ARG VITE_API_URL=http://localhost:5000/api
ARG VITE_GOOGLE_ORDER_FORM_URL=
ARG VITE_STORE_PHONE=1800 6868
ARG VITE_STORE_ADDRESS=TP. Cà Mau, tỉnh Cà Mau
ARG VITE_SOCIAL_FACEBOOK_URL=https://www.facebook.com/
ARG VITE_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/
ARG VITE_SOCIAL_TIKTOK_URL=https://www.tiktok.com/
ARG VITE_PAYMENT_MOMO_URL=
ARG VITE_PAYMENT_VNPAY_URL=
ARG VITE_PAYMENT_PAYPAL_URL=
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_GOOGLE_ORDER_FORM_URL=${VITE_GOOGLE_ORDER_FORM_URL}
ENV VITE_STORE_PHONE=${VITE_STORE_PHONE}
ENV VITE_STORE_ADDRESS=${VITE_STORE_ADDRESS}
ENV VITE_SOCIAL_FACEBOOK_URL=${VITE_SOCIAL_FACEBOOK_URL}
ENV VITE_SOCIAL_INSTAGRAM_URL=${VITE_SOCIAL_INSTAGRAM_URL}
ENV VITE_SOCIAL_TIKTOK_URL=${VITE_SOCIAL_TIKTOK_URL}
ENV VITE_PAYMENT_MOMO_URL=${VITE_PAYMENT_MOMO_URL}
ENV VITE_PAYMENT_VNPAY_URL=${VITE_PAYMENT_VNPAY_URL}
ENV VITE_PAYMENT_PAYPAL_URL=${VITE_PAYMENT_PAYPAL_URL}
COPY package*.json ./
RUN npm install
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
