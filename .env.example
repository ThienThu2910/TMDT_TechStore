# Copy this file to .env in the project root before starting Docker Compose.
# Replace every value before sharing the project or using it outside local development.
MYSQL_DATABASE=techstore_db
MYSQL_USER=techstore
MYSQL_PASSWORD=change_this_local_password
MYSQL_ROOT_PASSWORD=change_this_root_password

DB_HOST=db
DB_PORT=3306
DB_NAME=techstore_db
DB_USER=techstore
DB_PASSWORD=change_this_local_password

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
